# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
# PORT: HTTP server port (defaults to 3000).
PORT=3000
# NODE_ENV: development or production.
NODE_ENV=development
# APP_URL: Public URL where this applet is hosted.
APP_URL=
# DATABASE_URL: PostgreSQL connection string for production; leave unset to use local SQLite.
DATABASE_URL=
# PG_CA_CERT: Optional PEM CA certificate for managed PostgreSQL TLS verification.
PG_CA_CERT=
# DB_PATH: File path for local SQLite database (defaults to ./data/matlas.db).
DB_PATH=./data/matlas.db
# VITE_ASSET_MODE: remote (default CDN URLs) or local (self-hosted files under public/).
VITE_ASSET_MODE=remote
# VITE_MEDIA_BASE: Optional public base URL (no trailing slash) for the external media repository.
VITE_MEDIA_BASE=

